# Bot runtime settings. Copy to .env.production; never commit the filled file.
NODE_ENV=production
ASSISTANT_PROFILE=KiraMindBot
KIRA_BOT_TOKEN=
KIRA_ALLOWED_USER_ID=
KIRA_ADMIN_USER_ID=
KIRA_BOT_USERNAME=
OWNER_NAME=
OWNER_USERNAME=
USER_NAME=
USER_BIRTH_DATE=
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=KiraMind
DB_PASSWORD=
QDRANT_URL=http://qdrant:6333
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Images use these optional overrides or inherit OPENAI_API_KEY / OPENAI_BASE_URL.
# Model, size and quality can also be changed live in the admin panel.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_ENABLED=true
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Optional owner API. Keep the token private; do not embed it into an app binary.
KIRA_API_ENABLED=false
KIRA_API_TOKEN=
KIRA_API_HOST=127.0.0.1
KIRA_API_PORT=3200
# Optional separate account API (docker-compose.accounts.yml); never reuse an API token as the key.
KIRA_PLATFORM_MASTER_KEY=
KIRA_PLATFORM_DB_NAME=KiraPlatform
KIRA_PLATFORM_HOST=127.0.0.1
KIRA_PLATFORM_PORT=3300
KIRA_PLATFORM_DATA_DIR=runtime-data/accounts
KIRA_PLATFORM_MAX_ACCOUNTS=10
# Comma-separated Telegram bot IDs reserved by the operator, in addition to KIRA_BOT_TOKEN.
KIRA_PLATFORM_RESERVED_BOT_IDS=
# Экспериментальная архитектура; legacy включает прежний planner/executor без миграции данных.
KIRA_ORCHESTRATION_MODE=skills
KIRA_DECISIONS_ENABLED=false

# Optional service-provided free-dialogue model ID on the existing OpenAI-compatible gateway.
# An empty value makes this mode unavailable unless a suitable local model is connected.
KIRA_FREE_DIALOGUE_MODEL=
# Optional explicit free-dialogue model ID from the connected LM Studio catalog.
LM_STUDIO_FREE_MODEL=
