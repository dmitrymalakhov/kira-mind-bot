# Docker Compose settings. Copy to .env and fill private values locally.
KIRA_INSTANCE_NAME=
ADMIN_PORT=
# Optional external API overlay: choose a free, instance-specific host port.
API_PORT=
# Keep API publication enabled in scripts/ops/local.sh across container updates.
KIRA_API_PUBLISH=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
DB_USER=postgres
DB_NAME=KiraMind
DB_PASSWORD=
POSTGRES_VOLUME_NAME=
QDRANT_VOLUME_NAME=
# Optional lmrouter SSH tunnel.
COMPOSE_PROFILES=
LMROUTER_SSH_HOST=
LMROUTER_SSH_USER=
