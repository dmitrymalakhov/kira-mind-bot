# Docker Compose settings. Copy to .env and fill private values locally.
KIRA_INSTANCE_NAME=
ADMIN_PORT=
# Optional external API overlay: choose a free, instance-specific host port.
API_PORT=
# Optional multi-account API overlay, published only on localhost.
ACCOUNTS_PORT=8330
# Set by the existing-account migration; local.sh then starts the account manager instead of a second legacy poller.
KIRA_ACCOUNTS_MODE=false
# Keep API publication enabled in scripts/ops/local.sh across container updates.
KIRA_API_PUBLISH=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
DB_USER=postgres
DB_NAME=KiraMind
DB_PASSWORD=
POSTGRES_VOLUME_NAME=
QDRANT_VOLUME_NAME=
# Optional lmrouter SSH tunnel.
COMPOSE_PROFILES=
LMROUTER_SSH_HOST=
LMROUTER_SSH_USER=
# Ядро с тулами и скиллами включено по умолчанию; legacy — прежний planner/executor для сравнения.
KIRA_ORCHESTRATION_MODE=skills
KIRA_DECISIONS_ENABLED=false
KIRA_FAST_DIALOGUE_ENABLED=true
DIALOGUE_DEEP_REVIEW_ENABLED=true

# Optional service-provided free-dialogue model ID on the existing OpenAI-compatible gateway.
# An empty value makes this mode unavailable unless a suitable local model is connected.
KIRA_FREE_DIALOGUE_MODEL=
# Optional explicit free-dialogue model ID from the connected LM Studio catalog.
LM_STUDIO_FREE_MODEL=
