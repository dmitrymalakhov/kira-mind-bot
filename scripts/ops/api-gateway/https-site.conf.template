server {
    listen 443 ssl;
    server_name @@DOMAIN@@;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:KiraApiTLS:1m;
    ssl_session_timeout 5m;
    ssl_session_tickets off;

    # Public HTTPS also requires a device certificate; the CA key stays offline.
    ssl_client_certificate /etc/nginx/kira-api/client-ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 1;

    access_log /var/log/nginx/kira-api-access.log kira_api;
    error_log /var/log/nginx/kira-api-error.log warn;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Request-Id $request_id always;

    client_max_body_size 64k;
    client_body_buffer_size 64k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 60s;
    limit_req zone=kira_api_ip burst=10 nodelay;
    limit_req zone=kira_api_total burst=20 nodelay;
    limit_req_status 429;
    limit_conn kira_api_connections 8;
    limit_conn kira_api_total_connections 20;
    limit_conn_status 429;

    if ($host != @@DOMAIN@@) { return 421; }
    if ($kira_api_client_revoked) { return 403; }
    if ($kira_api_route_allowed = 0) { return 404; }

    location /api/v1/ {
        # Only shape validation here. The runtime checks the actual secret.
        if ($kira_api_has_bearer = 0) { return 401; }

        # No URI suffix: preserve /api/v1, query parameters and file URLs.
        # A stable Tailscale IPv4 avoids DNS dependency at nginx startup.
        proxy_pass https://@@UPSTREAM_IP@@:8443;
        proxy_http_version 1.1;
        proxy_set_header Host @@UPSTREAM_DNS@@;
        proxy_set_header Connection "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        proxy_ssl_server_name on;
        proxy_ssl_name @@UPSTREAM_DNS@@;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 600s;
        proxy_next_upstream off;
        proxy_ignore_client_abort on;
        proxy_cache off;
        proxy_store off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_request_buffering on;
        proxy_hide_header Cache-Control;
        proxy_hide_header X-Request-Id;
        proxy_hide_header X-Content-Type-Options;
    }

    location / { return 404; }
}
