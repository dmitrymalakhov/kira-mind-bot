{
  "openapi": "3.1.0",
  "info": {
    "title": "Kira accounts API",
    "version": "1.0.0",
    "description": "Управление аккаунтом и runtime. Канонические native auth/account контракты и доступность: public-accounts.openapi.json и GET /auth/config. Парольная регистрация закрыта."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/status": {
      "$ref": "./openapi.json#/paths/~1status"
    },
    "/capabilities": {
      "$ref": "./openapi.json#/paths/~1capabilities"
    },
    "/history": {
      "$ref": "./openapi.json#/paths/~1history"
    },
    "/reminders": {
      "$ref": "./openapi.json#/paths/~1reminders"
    },
    "/tasks": {
      "$ref": "./openapi.json#/paths/~1tasks"
    },
    "/messages": {
      "$ref": "./openapi.json#/paths/~1messages"
    },
    "/actions": {
      "$ref": "./openapi.json#/paths/~1actions"
    },
    "/files/{id}": {
      "$ref": "./openapi.json#/paths/~1files~1{id}"
    },
    "/accounts/register": {
      "$ref": "./public-accounts.openapi.json#/paths/~1accounts~1register"
    },
    "/accounts/login": {
      "$ref": "./public-accounts.openapi.json#/paths/~1accounts~1login"
    },
    "/accounts/logout": {
      "post": {
        "operationId": "logoutAccount",
        "summary": "Отозвать текущий токен",
        "responses": {
          "200": {
            "description": "Отозвать текущий токен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "./openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/account": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account"
    },
    "/account/bot": {
      "put": {
        "operationId": "connectAccountBot",
        "summary": "Подключить бота и получить ссылку подтверждения",
        "responses": {
          "202": {
            "description": "Подключить бота и получить ссылку подтверждения",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "awaiting_telegram"
                      ]
                    },
                    "pairingUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "expiresIn": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "./openapi.json#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "botToken": {
                    "type": "string",
                    "writeOnly": true
                  }
                },
                "required": [
                  "botToken"
                ]
              }
            }
          }
        }
      }
    },
    "/account/telegram": {
      "put": {
        "operationId": "connectAccountTelegram",
        "summary": "Подключить личную Telegram-сессию того же владельца",
        "responses": {
          "202": {
            "description": "Подключить личную Telegram-сессию того же владельца",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "restarting"
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "./openapi.json#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "apiId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "apiHash": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "sessionString": {
                    "type": "string",
                    "writeOnly": true
                  }
                },
                "required": [
                  "apiId",
                  "apiHash",
                  "sessionString"
                ]
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getAccountTelegram",
        "summary": "Check personal Telegram session configuration without returning credentials",
        "responses": {
          "200": {
            "description": "Own session status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "personalSessionConfigured": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "personalSessionConfigured"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "./openapi.json#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "disconnectAccountTelegram",
        "summary": "Remove own personal Telegram session and restart the runtime; keep the bot and stored memories",
        "responses": {
          "200": {
            "description": "Already disconnected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "personalSessionConfigured": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "personalSessionConfigured"
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Session removed, runtime restarting",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "personalSessionConfigured": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "restarting"
                      ]
                    }
                  },
                  "required": [
                    "personalSessionConfigured",
                    "status"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "./openapi.json#/components/responses/Error"
          }
        }
      }
    },
    "/settings": {
      "$ref": "./openapi.json#/paths/~1settings"
    },
    "/model-settings": {
      "$ref": "./openapi.json#/paths/~1model-settings"
    },
    "/scene": {
      "$ref": "./openapi.json#/paths/~1scene"
    },
    "/scene/turns": {
      "$ref": "./openapi.json#/paths/~1scene~1turns"
    },
    "/scene/action-results": {
      "$ref": "./openapi.json#/paths/~1scene~1action-results"
    },
    "/photos": {
      "$ref": "./openapi.json#/paths/~1photos"
    },
    "/auth/config": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1config"
    },
    "/auth/challenges": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1challenges"
    },
    "/auth/apple": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1apple"
    },
    "/auth/google": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1google"
    },
    "/auth/telegram": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1telegram"
    },
    "/auth/password": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1password"
    },
    "/auth/refresh": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1refresh"
    },
    "/auth/logout": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1logout"
    },
    "/auth/events/apple": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1events~1apple"
    },
    "/auth/events/google": {
      "$ref": "./public-accounts.openapi.json#/paths/~1auth~1events~1google"
    },
    "/account/identities": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1identities"
    },
    "/account/identities/{identityId}": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1identities~1{identityId}"
    },
    "/account/sessions": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1sessions"
    },
    "/account/sessions/{sessionId}": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1sessions~1{sessionId}"
    },
    "/account/consents": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1consents"
    },
    "/account/activate": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1activate"
    },
    "/account/quota": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1quota"
    },
    "/account/push-devices": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1push-devices"
    },
    "/account/push-devices/{deviceId}": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1push-devices~1{deviceId}"
    },
    "/account/complaints": {
      "$ref": "./public-accounts.openapi.json#/paths/~1account~1complaints"
    },
    "/notifications": {
      "$ref": "./public-accounts.openapi.json#/paths/~1notifications"
    },
    "/notifications/{id}/read": {
      "$ref": "./public-accounts.openapi.json#/paths/~1notifications~1{id}~1read"
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Account access token returned by registration/login"
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "bot": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "connected": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "username",
          "bot"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer"
          }
        },
        "required": [
          "account",
          "accessToken",
          "tokenType",
          "expiresIn"
        ]
      }
    }
  }
}
