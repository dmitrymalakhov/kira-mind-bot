{
  "openapi": "3.0.3",
  "info": {
    "title": "Kira owner API",
    "version": "1.0.0",
    "description": "Owner-only API sharing the bot's handlers and knowledge. API dialogue is separate; background notifications use Telegram."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "Runtime API status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "apiVersion": {
                      "type": "string"
                    },
                    "characterName": {
                      "type": "string"
                    },
                    "channel": {
                      "type": "string",
                      "enum": [
                        "api"
                      ]
                    },
                    "sharedKnowledge": {
                      "type": "boolean"
                    },
                    "notificationsChannel": {
                      "type": "string",
                      "enum": [
                        "telegram"
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Supported formats and shared bot capability catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "output": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "title",
                          "category",
                          "summary",
                          "examples"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "summary": {
                            "type": "string"
                          },
                          "examples": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "commands": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "limitations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "ownerOnly": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/history": {
      "get": {
        "operationId": "getHistory",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent API dialogue, oldest first; this is a bounded window, not a full archive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "messages"
                  ],
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "role",
                          "text",
                          "createdAt"
                        ],
                        "properties": {
                          "role": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/reminders": {
      "get": {
        "operationId": "getReminders",
        "responses": {
          "200": {
            "description": "Active personal reminders from the shared registry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "reminders"
                  ],
                  "properties": {
                    "reminders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "text",
                          "dueAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "dueAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "recurrence": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "operationId": "getTasks",
        "responses": {
          "200": {
            "description": "Up to 100 shared recurring tasks belonging to the owner",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tasks",
                    "hasMore"
                  ],
                  "properties": {
                    "hasMore": {
                      "type": "boolean"
                    },
                    "tasks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "title",
                          "prompt",
                          "status",
                          "schedule",
                          "nextRunAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "prompt": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "schedule": {
                            "type": "object",
                            "additionalProperties": true
                          },
                          "nextRunAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "lastResult": {
                            "type": "string",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/messages": {
      "post": {
        "operationId": "sendMessage",
        "description": "Runs the complete shared text/command flow. Retry the exact body with the same key after a connection loss. Does not cancel work when the client disconnects.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Reply"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/actions": {
      "post": {
        "operationId": "invokeAction",
        "description": "Invoke a signed button from the latest API turn, within 15 minutes. The same token cannot execute twice, even with a different idempotency key.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "actionToken"
                ],
                "properties": {
                  "actionToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Reply"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/files/{id}": {
      "get": {
        "operationId": "downloadFile",
        "description": "Download a generated file, available for 24 hours. Authorization is required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File bytes; Content-Disposition supplies the filename",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal owner token; provision at setup, never embed in a distributed app."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        }
      }
    },
    "responses": {
      "Reply": {
        "description": "Completed response or replayed durable receipt",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Reply"
            }
          }
        }
      },
      "Error": {
        "description": "400 invalid request; 401 unauthorized; 404 missing; 409 busy/conflict/uncertain; 410 expired action; 413 too large; 415 content type; 422 unsupported delivery; 429 rate limited; 500 internal error. Never automatically resubmit an uncertain operation using a new key.",
        "headers": {
          "X-Request-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          "Retry-After": {
            "description": "Present for rate limiting and a busy conversation",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error",
                "requestId"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "requestId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Reply": {
        "type": "object",
        "required": [
          "messages"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Negative channel message ID. Upsert by ID when replaying receipts."
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "notice",
              "photo",
              "document",
              "voice",
              "delete"
            ]
          },
          "text": {
            "type": "string",
            "description": "May be absent for markup-only edits; preserve the original text."
          },
          "format": {
            "type": "string",
            "enum": [
              "plain",
              "html"
            ]
          },
          "replacesMessageId": {
            "type": "integer",
            "format": "int64"
          },
          "buttons": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Button"
              }
            }
          },
          "fileUrl": {
            "type": "string",
            "description": "Relative authorized API file path or external HTTP(S) media URL. Do not forward the owner token to external URLs."
          },
          "filename": {
            "type": "string"
          }
        }
      },
      "Button": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "actionToken": {
            "type": "string",
            "description": "Opaque signed action token"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
